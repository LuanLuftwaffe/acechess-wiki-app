<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_window_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_window">

    <!-- Status Bar Spacer (Guarantees safe gap below phone clock/status bar) -->
    <View
        android:id="@+id/view_status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#E6131B2E" />

    <!-- Top Bar: LoLChess Style Header (Close + Title + Opacity Slider) -->
    <LinearLayout
        android:id="@+id/layout_window_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E6131B2E"
        android:paddingHorizontal="12dp">

        <!-- Close / Collapse Button -->
        <ImageView
            android:id="@+id/img_window_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="5dp"
            android:src="@drawable/ic_close_white_24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng về bong bóng" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AceChess Tool"
            android:textColor="@color/gold_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <!-- Opacity Label & SeekBar -->
        <TextView
            android:id="@+id/tv_opacity_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="95%"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="4dp" />

        <SeekBar
            android:id="@+id/seekBarOverlayAlpha"
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="95"
            android:thumbTint="@color/emerald_green"
            android:progressTint="@color/emerald_green" />
    </LinearLayout>

    <!-- Mini Web Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/mini_web_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Mini WebView (Embedded In-Game Wiki) -->
    <WebView
        android:id="@+id/mini_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
