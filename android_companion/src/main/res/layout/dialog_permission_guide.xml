<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cấp Quyền Bong Bóng Nổi"
        android:textColor="@color/gold_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_guide_device_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thiết bị của bạn: Xiaomi / HyperOS"
        android:textColor="@color/emerald_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tv_guide_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Nhấn nút bên dưới để mở trang cài đặt quyền hệ thống.\n2. Bật công tắc 'Cho phép hiển thị trên các ứng dụng khác'.\n3. [Quan trọng với Xiaomi/HyperOS]: Vào mục 'Quyền khác' -> Bật 'Hiển thị cửa sổ bật lên khi chạy dưới nền'."
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Để Sau"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_dark_card"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_dialog_open_settings"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.6"
            android:text="Mở Cài Đặt Ngay"
            android:textColor="@color/bg_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_gold_btn"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
