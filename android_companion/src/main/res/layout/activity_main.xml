<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top App Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@color/bg_surface"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/gold_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Toggle Bubble Button -->
        <Button
            android:id="@+id/btn_header_bubble"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Bong Bóng"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_gold_btn"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp" />

        <!-- Open Control Center Button -->
        <Button
            android:id="@+id/btn_header_tools"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Việt Hóa"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_dark_card"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Web Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/web_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/layout_header"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Main Fullscreen WebView -->
    <WebView
        android:id="@+id/main_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/web_progress_bar" />

    <!-- Slide-Up Control Panel (Bottom Sheet Style) -->
    <RelativeLayout
        android:id="@+id/panel_control_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        android:background="@color/bg_surface_elevated"
        android:elevation="16dp"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Panel Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tv_panel_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trung Tâm Dịch Vụ Việt Hóa"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_close_panel"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Status Indicators -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Shizuku / Install Mode Status Badge -->
                    <TextView
                        android:id="@+id/badge_shizuku_status"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Quyền: Đang Kiểm Tra..."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_pill_amber"
                        android:layout_marginEnd="6dp" />

                    <!-- Game Status Badge -->
                    <TextView
                        android:id="@+id/badge_game_status"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Game: Đang Kiểm Tra..."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_pill_amber"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Selectable Services Card (Dark Gold Card) -->
                <LinearLayout
                    android:id="@+id/card_services"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dark_card"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TÙY CHỌN DỊCH VỤ CÀI ĐẶT"
                        android:textColor="@color/gold_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <CheckBox
                        android:id="@+id/cb_service_font"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Font &amp; Ngôn ngữ Tiếng Việt (Lõi DEX &amp; Menu)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:checked="true"
                        android:buttonTint="@color/gold_primary" />

                    <CheckBox
                        android:id="@+id/cb_service_images"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gói Hình Ảnh Giao Diện &amp; Nút Bấm (ImagePack)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:checked="true"
                        android:buttonTint="@color/gold_primary" />

                    <CheckBox
                        android:id="@+id/cb_service_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đồng Bộ Đội Hình Meta &amp; Dịch AI (Live Hot-sync)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:checked="true"
                        android:buttonTint="@color/gold_primary" />

                    <CheckBox
                        android:id="@+id/cb_service_music"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quản Lý Nhạc Nền Trận Đấu (Battle Music)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:checked="false"
                        android:buttonTint="@color/gold_primary" />

                    <CheckBox
                        android:id="@+id/cb_service_showtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tùy Chỉnh Chữ Sân Khấu Mở Màn (SHOW TIME)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:checked="false"
                        android:buttonTint="@color/gold_primary" />
                </LinearLayout>

                <!-- Floating Overlay Permission Card -->
                <LinearLayout
                    android:id="@+id/card_overlay_perm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dark_card"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quyền Cửa Sổ Nổi (Bong Bóng)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badge_overlay_perm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="CHƯA CẤP"
                            android:textColor="@color/amber_orange"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <Button
                        android:id="@+id/btn_open_overlay_settings"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="6dp"
                        android:text="CẤP QUYỀN HIỂN THỊ CỬA SỔ NỔI"
                        android:textColor="@color/bg_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_gold_btn" />
                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btn_apply_viet_patch"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.2"
                        android:text="@string/btn_apply_patch"
                        android:textColor="@color/bg_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_gold_btn"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_restore_original"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="0.8"
                        android:text="@string/btn_restore_game"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_ruby_btn"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Terminal / Progress Console -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#050811"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tv_console_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sẵn sàng: AceChess Tool Việt Hóa v2.0\nChọn các dịch vụ mong muốn và nhấn 'BẮT ĐẦU CÀI ĐẶT VIỆT HÓA'."
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </ScrollView>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</RelativeLayout>
