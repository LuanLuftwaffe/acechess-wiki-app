<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top App Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@color/bg_surface"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/gold_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Toggle Bubble Button -->
        <Button
            android:id="@+id/btn_header_bubble"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="BONG BÓNG"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_gold_btn"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp" />

        <!-- Tool / Control Center Button -->
        <Button
            android:id="@+id/btn_header_tools"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="VIỆT HÓA"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_dark_card"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Web Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/web_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/layout_header"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Main Fullscreen WebView -->
    <WebView
        android:id="@+id/main_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/web_progress_bar" />

    <!-- Slide-Up Control Panel (Bottom Sheet Style) -->
    <RelativeLayout
        android:id="@+id/panel_addon_manager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        android:background="@color/bg_surface_elevated"
        android:elevation="16dp"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Panel Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_addon_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_shizuku"
                        android:textColor="@color/gold_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_close_addon_panel"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/badge_addon_status"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:text="Trạng thái: Đang kiểm tra..."
                    android:textColor="@color/amber_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dark_card"
                    android:layout_marginBottom="12dp" />

                <!-- ============================================================== -->
                <!-- CHẾ ĐỘ 1: KHI CHƯA CÀI ĐẶT ADD-ON (GIỚI THIỆU & TẢI VỀ)          -->
                <!-- ============================================================== -->
                <LinearLayout
                    android:id="@+id/layout_addon_uninstalled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THÔNG TIN TIỆN ÍCH BỔ SUNG"
                            android:textColor="@color/gold_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tv_addon_desc_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Add-on là gói tiện ích riêng biệt chuyên trách nạp ngôn ngữ Tiếng Việt và tối ưu hiển thị cho game Vương Giả Vạn Tượng Kỳ.\n• Hoạt động an toàn qua dịch vụ Shizuku, không yêu cầu can thiệp hệ thống trực tiếp từ app chính.\n• Là tiện ích TUỲ CHỌN: Bạn có thể cài đặt khi cần và gỡ bỏ bất kỳ lúc nào mà không ảnh hưởng tới Cẩm nang tra cứu và Bong bóng nổi.\n• Dung lượng siêu nhẹ: ~1.3 MB."
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                    <!-- Download Progress Area -->
                    <LinearLayout
                        android:id="@+id/layout_addon_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:background="@drawable/bg_dark_card"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang tải gói Add-on cài đặt..."
                            android:textColor="@color/gold_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <ProgressBar
                            android:id="@+id/progress_addon_download"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:max="100"
                            android:progress="0"
                            android:layout_marginVertical="6dp" />

                        <TextView
                            android:id="@+id/tv_addon_progress_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 KB / 0 KB (0%)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Uninstalled Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_addon_action"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="TẢI &amp; CÀI ĐẶT ADD-ON"
                            android:textColor="@color/bg_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_gold_btn" />

                        <Button
                            android:id="@+id/btn_addon_cancel"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="HỦY"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:background="@drawable/bg_dark_card"
                            android:visibility="gone"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============================================================== -->
                <!-- CHẾ ĐỘ 2: KHI ĐÃ CÀI ĐẶT ADD-ON (100% GIAO DIỆN BẢN GỐC BACKUP) -->
                <!-- ============================================================== -->
                <LinearLayout
                    android:id="@+id/layout_addon_installed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Shizuku & Game Status Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Trạng Thái Shizuku:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_shizuku_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đang kết nối..."
                                android:textColor="@color/amber_orange"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btn_req_shizuku_ipc"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:text="Cấp Quyền"
                                android:textSize="10sp"
                                android:textColor="@color/bg_primary"
                                android:background="@drawable/bg_gold_btn"
                                android:paddingHorizontal="8dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Game HoK Ace:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_game_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đang kiểm tra..."
                                android:textColor="@color/emerald_green"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Service Options (Checkboxes as in original backup) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="10dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TÙY CHỌN DỊCH VỤ VIỆT HÓA"
                            android:textColor="@color/gold_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <CheckBox
                            android:id="@+id/chk_font"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:text="Font Tiếng Việt (Oswald Bold HOKVI)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:checked="true"
                            android:buttonTint="@color/gold_primary" />

                        <CheckBox
                            android:id="@+id/chk_ui"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:text="Bản Dịch Giao Diện &amp; Thẻ Tướng (1.db &amp; 4.db)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:checked="true"
                            android:buttonTint="@color/gold_primary" />

                        <CheckBox
                            android:id="@+id/chk_meta"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:text="Dữ Liệu Đội Hình Meta &amp; AI Khuyên Dùng"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:checked="true"
                            android:buttonTint="@color/gold_primary" />

                        <CheckBox
                            android:id="@+id/chk_music"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:text="Nhạc Trận Đấu Bản Quyền (Music Battle)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:checked="true"
                            android:buttonTint="@color/gold_primary" />
                    </LinearLayout>

                    <!-- Action Buttons -->
                    <Button
                        android:id="@+id/btn_ipc_apply_patch"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="BẮT ĐẦU CÀI ĐẶT VIỆT HÓA"
                        android:textColor="@color/bg_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_gold_btn"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <Button
                            android:id="@+id/btn_ipc_restore_game"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="KHÔI PHỤC GỐC"
                            android:textColor="@color/ruby_red"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_ruby_btn"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_ipc_launch_game"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="MỞ GAME"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_dark_card"
                            android:layout_marginHorizontal="4dp" />

                        <Button
                            android:id="@+id/btn_addon_uninstall"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="GỠ TIỆN ÍCH"
                            android:textColor="@color/ruby_red"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_ruby_btn"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- Terminal Console Log (Exact 100% parity with backup) -->
                    <ScrollView
                        android:id="@+id/scroll_console"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="#050811"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tv_console_log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="► Sẵn sàng: AceChess Tool Việt Hóa (Modular Edition)\n► Chọn tùy chọn và nhấn 'BẮT ĐẦU CÀI ĐẶT VIỆT HÓA'."
                            android:textColor="#34D399"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="2dp" />
                    </ScrollView>

                    <!-- Footer Note -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Lưu ý: Bạn nên nhấn 'Khôi phục gốc' trước khi gỡ tiện ích nếu muốn trả game về nguyên bản."
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</RelativeLayout>
