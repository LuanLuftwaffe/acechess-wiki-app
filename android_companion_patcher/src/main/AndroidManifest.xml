<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.acechess.viethoa.patcher"
    android:versionCode="101"
    android:versionName="1.0.1">

    <!-- 1. Quyền tải gói dữ liệu từ máy chủ CDN -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 2. Quyền kết nối dịch vụ Shizuku API để ghi tệp vào game -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 3. Quyền thông báo gói dữ liệu mới (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 4. Giữ CPU không ngủ trong khi tải và ghi tệp nặng -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 5. Quyền bảo vệ Signature: Chỉ ứng dụng cùng Keystore mới được gọi mở Activity -->
    <permission
        android:name="com.acechess.viethoa.permission.ACCESS_PATCHER"
        android:protectionLevel="signature" />

    <!-- Khai báo Package Visibility cho Android 11+ -->
    <queries>
        <package android:name="com.tencent.tmgp.osgame" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.acechess.viethoa" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/patcher_app_name"
        android:roundIcon="@drawable/ic_logo_circle"
        android:supportsRtl="true"
        android:theme="@style/Theme.AceChess">

        <!-- Ẩn icon Launcher (0 category LAUNCHER), bảo vệ bằng Signature Permission -->
        <activity
            android:name="com.acechess.viethoa.patcher.PatcherMainActivity"
            android:exported="true"
            android:permission="com.acechess.viethoa.permission.ACCESS_PATCHER"
            android:theme="@style/Theme.AceChess" />

        <!-- IPC Provider phục vụ giao tiếp 2 chiều trực tiếp với App Chính (AceChess Companion) -->
        <provider
            android:name="com.acechess.viethoa.patcher.PatcherIpcProvider"
            android:authorities="com.acechess.viethoa.patcher.ipc"
            android:exported="true"
            android:permission="com.acechess.viethoa.permission.ACCESS_PATCHER" />

        <!-- Điểm neo IPC Shizuku Provider nếu client Shizuku yêu cầu -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.acechess.viethoa.patcher.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERNET" />

    </application>

</manifest>
