<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E17"
    android:padding="16dp">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="AceChess Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patcher_app_name"
                android:textColor="#F5A623"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patcher_app_subtitle"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:background="@drawable/bg_dark_card"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#D1D5DB"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: System Status (Game & Shizuku) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dark_card"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRẠNG THÁI HỆ THỐNG"
                    android:textColor="#E5E7EB"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Game row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Game HoK Ace:"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_game_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang kiểm tra..."
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Shizuku row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dịch vụ Shizuku:"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_shizuku_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang kiểm tra..."
                        android:textColor="#F59E0B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_req_shizuku"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:text="Cấp Quyền"
                        android:textSize="11sp"
                        android:textColor="#000000"
                        android:background="@drawable/bg_gold_btn"
                        android:paddingHorizontal="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Patch Pack Version Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dark_card"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GÓI DỮ LIỆU VIỆT HÓA"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_check_update_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kiểm tra mới ⟳"
                        android:textColor="#60A5FA"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bản vá đã cài:"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_installed_patch_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa cài đặt"
                        android:textColor="#F3F4F6"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bản vá mới nhất:"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_latest_patch_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.8.0.1"
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Download & Patch Progress Bar -->
            <LinearLayout
                android:id="@+id/card_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dark_card"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_progress_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đang tải gói dữ liệu..."
                        android:textColor="#FCD34D"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#FCD34D"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_progress_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chuẩn bị tệp..."
                        android:textColor="#9CA3AF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_cancel_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Hủy"
                        android:textSize="11sp"
                        android:textColor="#EF4444"
                        android:background="@drawable/bg_dark_card"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 4: Console Log Window -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NHẬT KÝ XỬ LÝ (TERMINAL)"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="#050811"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_console_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="► Chào mừng đến với AceChess Patcher Add-on.\n► Nhấn 'VÁ GAME TOÀN DIỆN' để bắt đầu đồng bộ ngôn ngữ."
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Buttons Group -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btn_action_patch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_start_patch"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_gold_btn"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_action_restore"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/btn_restore_game"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_ruby_btn"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_action_launch_game"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/btn_launch_game"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_dark_card"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
