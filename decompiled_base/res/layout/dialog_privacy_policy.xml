            <TextView android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/colorDialogTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16.0dp" android:text="1. Cam kết quyền riêng tư" />
            <TextView android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/colorDialogContent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="Ace Chess Wiki tôn trọng và cam kết bảo vệ quyền riêng tư của mọi người dùng. Ứng dụng cung cấp các công cụ tra cứu, cẩm nang và tiện ích hỗ trợ chơi game Đấu Trường Chân Lý hoàn toàn độc lập." />
            
