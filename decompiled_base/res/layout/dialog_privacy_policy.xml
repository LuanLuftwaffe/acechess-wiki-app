            <TextView android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/colorDialogContent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="Ứng dụng không thu thập thông tin nhận dạng cá nhân, số điện thoại hay tài khoản ngân hàng. Toàn bộ thiết lập cá nhân như danh sách đội hình yêu thích hay cấu hình bong bóng đều được lưu trữ trực tiếp trên thiết bị của bạn." />
            
            <TextView android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/colorDialogTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16.0dp" android:text="3. Quyền hạn ứng dụng" />
            <TextView android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/colorTextSecondary" android:id="@id/txtServiceProvidersContent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:text="Quyền hiển thị trên các ứng dụng khác (Bong bóng tiện ích) chỉ được sử dụng khi bạn bật tính năng này nhằm giúp việc tra cứu trong lúc chơi game thuận tiện hơn." />
            
            <TextView android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/colorTextPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16.0dp" android:text="4. Bảo mật dữ liệu" />
